{
  "name": "hausofmusa",
  "private": true,
  "version": "0.1.0",
  "description": "Haus of Musa — ultra-premium IT company website (monorepo: Next.js on Vercel, Supabase backend)",
  "scripts": {
    "dev": "pnpm --parallel --filter @hausofmusa/web --filter @hausofmusa/admin dev",
    "dev:web": "pnpm --filter @hausofmusa/web dev",
    "dev:admin": "pnpm --filter @hausofmusa/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "seed:admin": "pnpm --filter @hausofmusa/data seed:admin",
    "seed:products": "pnpm --filter @hausofmusa/data seed:products",
    "seed:career-roles": "pnpm --filter @hausofmusa/data seed:career-roles"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2"
}
