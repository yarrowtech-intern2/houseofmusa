{
  "name": "houseofmusa",
  "private": true,
  "version": "0.1.0",
  "description": "House of Musa — ultra-premium IT company website (monorepo: Next.js on Vercel, Supabase backend)",
  "scripts": {
    "dev": "pnpm --parallel --filter @houseofmusa/web --filter @houseofmusa/admin dev",
    "dev:web": "pnpm --filter @houseofmusa/web dev",
    "dev:admin": "pnpm --filter @houseofmusa/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "seed:admin": "pnpm --filter @houseofmusa/data seed:admin",
    "seed:products": "pnpm --filter @houseofmusa/data seed:products",
    "seed:career-roles": "pnpm --filter @houseofmusa/data seed:career-roles"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2"
}
